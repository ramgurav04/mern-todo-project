# Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret key (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Server port (Vercel sets this automatically, you only need it locally)
PORT=3000

# Allowed frontend URL for CORS (set this to your deployed frontend URL on Vercel)
FRONTEND_URL=https://your-frontend-app.vercel.app
