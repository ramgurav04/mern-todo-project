# Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret key (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Server port (Vercel sets this automatically; only needed locally)
PORT=3000

# Allowed frontend origin(s) for CORS — comma-separated if multiple
# In Vercel multi-service, both services share one domain so CORS is same-origin; only needed for standalone deploy
FRONTEND_URL=http://localhost:5173
